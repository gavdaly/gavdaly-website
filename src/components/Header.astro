---
import ThemeToggle from "@/components/ThemeToggle.astro";
import VectorSearch from "@/components/VectorSearch.astro";
const pathname = new URL(Astro.request.url).pathname;
const links = [
  { label: "home", href: "/" }, { label: "posts", href: "/posts" }, { label: "projects", href: "/projects" },
  { label: "developer", href: "/developer" }, { label: "contact", href: "/contact" }, { label: "uses", href: "/uses" },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--border)] bg-[rgba(48,52,70,0.75)] backdrop-blur-md [-webkit-backdrop-filter:blur(12px)]">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4 md:px-10">
    <a href="/" class="text-lg font-bold tracking-tight text-[var(--text)]">Gavin Daly</a>
    <nav aria-label="Primary" class="flex items-center gap-4">
      <ul role="list" class="hidden items-center gap-5 text-sm md:flex">
        {links.map((link) => <li><a href={link.href} aria-current={pathname === link.href ? "page" : undefined} class:list={["border-b-2 border-transparent pb-1 transition-colors hover:text-[var(--accent-hover)]", pathname === link.href && "border-[var(--accent)] text-[var(--accent)]"]}>{link.label}</a></li>)}
      </ul>
      <VectorSearch />
      <ThemeToggle />
    </nav>
  </div>
</header>
