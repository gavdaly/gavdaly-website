---
import CardLink from "@/components/CardLink.astro";
import ProjectStatusIcon from "@/components/ProjectStatusIcon.astro";
import type { Project } from "@/data/projects";
import { PROJECT_STATUS_META } from "@/data/projects";

type Props = Project & {
  animationDelay?: number;
};

const { title, technology, status, slug, summary, animationDelay = 0 } = Astro.props;

const statusMeta = PROJECT_STATUS_META[status];
---

<CardLink
  href={`/projects/${slug}`}
  class="w-full"
  style={{ animationDelay: `${animationDelay}ms` }}
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h2 class="text-lg font-bold">{title}</h2>

    <span
      class={`status-badge inline-flex items-center gap-2 rounded-md px-3 py-1 text-xs font-semibold uppercase tracking-wide ${statusMeta.badgeClass}`}
    >
      <ProjectStatusIcon status={status} />
      <span class="whitespace-nowrap">{status}</span>
    </span>
  </div>
  {summary && <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">{summary}</p>}
  <div class="mt-4 flex flex-wrap gap-2">{technology.map((tech) => <span class="tag">{tech}</span>)}</div>
</CardLink>
