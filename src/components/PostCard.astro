---
import CardLink from "@/components/CardLink.astro";
import formatDate from "@/utils/formatDate";
import readingTime from "@/utils/readingTime";

type Props = {
  title: string;
  publishedAt: Date;
  description: string;
  slug: string;
  body: string;
  animationDelay?: number;
};

const { title, publishedAt, description, slug, body, animationDelay = 0 } = Astro.props;
---

<CardLink href={`/posts/${slug}`} style={{ animationDelay: `${animationDelay}ms` }}>
  <div class="mb-4 flex items-start justify-between gap-3">
    <p class="text-lg font-bold leading-tight group-hover:text-[var(--accent)]">{title}</p>
    <span aria-hidden="true" class="text-[var(--text-faint)] transition-transform group-hover:translate-x-1">→</span>
  </div>
  <div class="flex flex-wrap gap-2"><time datetime={publishedAt.toISOString()} class="tag">{formatDate(publishedAt)}</time><span class="tag">{readingTime(body)}</span></div>
  <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-[var(--text-muted)]">{description.replaceAll("**", "")}</p>
</CardLink>
