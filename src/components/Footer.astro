---
const commit = import.meta.env.CF_PAGES_COMMIT_SHA ?? import.meta.env.GITHUB_SHA;
---

<footer class="border-t border-[var(--border)] px-6 py-8 text-[var(--text-muted)] md:px-10">
  <div class="mx-auto flex max-w-5xl flex-col gap-3 text-sm sm:flex-row sm:items-center sm:justify-between">
    <span>© 2026 Gavin Daly</span>
    <nav aria-label="Footer" class="flex gap-5">
      <a class="transition-colors hover:text-[var(--accent-hover)]" href="/rss.xml">RSS</a>
      <a class="transition-colors hover:text-[var(--accent-hover)]" href="https://github.com/gavdaly">GitHub</a>
    </nav>
  </div>
  {commit && (
    <div class="mx-auto mt-5 max-w-5xl font-mono text-xs">
      Build <a class="transition-colors hover:text-[var(--accent-hover)]" href={`https://github.com/gavdaly/gavdaly-website/commit/${commit}`}>{commit.slice(0, 7)}</a>
    </div>
  )}
</footer>
