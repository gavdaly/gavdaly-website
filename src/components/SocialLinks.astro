---
import { presentation } from "@/data/presentation";
const { socials } = presentation;
---

<ul role="list" class="flex items-center gap-4">
  {socials.map(({ label, link, image }) => <li><a href={link} aria-label={`${label} profile`} class="block text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]"><svg class="icon h-5 w-5" aria-hidden="true"><use href={`#${image}`} /></svg></a></li>)}
</ul>
