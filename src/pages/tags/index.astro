---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Tags from "@/components/Tags.astro";

const tag_store: Map<string, [{ title: string; url: string }]> = new Map();

const notes = await getCollection("notes");
const posts = await getCollection("posts");
const projects = await getCollection("projects");

notes.forEach((note) => {
  note.data.tags?.forEach((tag) => {
    let data = {
      title: note.data.title,
      url: `/notes/${note.id}`,
    };
    let t = tag_store.get(tag);
    if (t) {
      t.push(data);
    } else {
      tag_store.set(tag, [data]);
    }
  });
});

projects.forEach((project) => {
  project.data.tags?.forEach((tag) => {
    let data = {
      title: project.data.title,
      url: `/projects/${project.id}`,
    };
    let t = tag_store.get(tag);
    if (t) {
      t.push(data);
    } else {
      tag_store.set(tag, [data]);
    }
  });
});

posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    let data = {
      title: post.data.title,
      url: `/posts/${post.id}`,
    };
    let t = tag_store.get(tag);
    if (t) {
      t.push(data);
    } else {
      tag_store.set(tag, [data]);
    }
  });
});
const names = Array.from(tag_store.keys());
---

<Layout
  title="Tags on Gavin Daly's site | GavDaly"
  description="A listing of topics from Gavin Daly's posts, notes, and projects."
>
  <h1>Topics on Gavin Daly's site</h1>
  <Tags names={names} />
</Layout>
