---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";

const notes = await getCollection("notes");
---

<Layout title="Notes by Gavin Daly | GavDaly" description="Technical notes by Gavin Daly about software, infrastructure, privacy, and security.">
  <h1>Notes by Gavin Daly</h1>
  <ul>
    {
      notes.map((note) => (
        <li>
          <a href={`/notes/${note.id}`}>{note.data.title}</a>
        </li>
      ))
    }
  </ul>
</Layout>
