---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import formatDate from "@/utils/formatDate";
import readingTime from "@/utils/readingTime";
import { SITE_URL } from "@/data/config";

const posts = (await getCollection("posts")).sort(function (first, second) {
  return second.data.publishedAt.getTime() - first.data.publishedAt.getTime();
});

const postsUrl = new URL("/posts", SITE_URL).toString();

const structuredDataJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      name: "Gavin Daly — Posts",
      url: postsUrl,
      blogPost: posts.map((post) => ({
        "@type": "BlogPosting",
        headline: post.data.title,
        description: post.data.description,
        datePublished: post.data.publishedAt.toISOString(),
        url: new URL(`/posts/${post.id}`, SITE_URL).toString(),
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: SITE_URL,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Posts",
          item: postsUrl,
        },
      ],
    },
  ],
});
---

<head>
  <script is:inline type="application/ld+json">
    {structuredDataJson}
  </script>
</head>

<Layout title="Posts by Gavin Daly | GavDaly" description="Writing by Gavin Daly about software, infrastructure, privacy, and security.">
  <main class="flex flex-col">
    <h1 class="mb-8 text-[var(--text-3xl)] font-semibold">Posts by Gavin Daly</h1>

    <article class="flex flex-col gap-4">
      {
        posts.map((post) => (
          <a class="group flex flex-col gap-3 border-l border-transparent py-4 pl-4 transition-colors hover:border-[var(--accent)]" href={`/posts/${post.id}`}>
            <h2 class="text-[var(--text-xl)] font-semibold transition-colors group-hover:text-[var(--accent)]">{post.data.title}</h2>
            <div class="flex flex-wrap gap-2"><time class="tag" datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time><span class="tag">{readingTime(post.body ?? "")}</span></div>
            <p class="max-w-2xl text-[var(--text-muted)]">{post.data.description.replaceAll("**", "")}</p>
          </a>
        ))
      }
    </article>
  </main>
</Layout>
